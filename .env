# ==========================================================
# PROVENANCE-GUARDED RED-TEAM HARNESS — LOCAL OLLAMA CONFIG
# Environment Configuration
# ==========================================================

# ── Person A: Ollama Target Models ────────────────────────
# Ollama must be running locally. Pull models before starting:
#   ollama pull phi3:mini
#   ollama pull qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_HOST=http://localhost:11434
TARGET_MODEL_V1=phi3:mini
TARGET_MODEL_V2=qwen2.5:3b
TARGET_MODEL_TEMPERATURE=0.7

# ── Person B: Scope Guard LLM ────────────────────────────
# Using Ollama for scope guard (no API key needed)
SCOPE_GUARD_PROVIDER=ollama
SCOPE_GUARD_MODEL=qwen2.5:3b

# ── Person C: LLM Judge ──────────────────────────────────
# Using Ollama as judge (no API key required, fast local inference)
JUDGE_LLM_PROVIDER=ollama
JUDGE_LLM_ENDPOINT=http://localhost:11434/api/chat
JUDGE_LLM_MODEL=qwen2.5:3b

# ── Person D: Attacker Model (Prompt Mutator) ────────────
# Using Ollama for prompt mutation
ATTACKER_MODEL=qwen2.5:3b

# ── Mock Mode (offline demo, no API calls) ─────────────────
# Set to false to use live Ollama LLMs
USE_MOCK_JUDGES=true

# ── Person B: MongoDB (Audit Chain) ───────────────────────
MONGODB_URI=mongodb://localhost:27017/redteam-audit

# ── Person B: Session Log Path ────────────────────────────
SESSION_LOG_PATH=./data/sessions.jsonl

# ── NitroStack Configuration ──────────────────────────────
NITRO_LOG_LEVEL=info

# -- Provenance Guard Configuration ------------------------
AUDIT_HMAC_KEY=1234567890abcdef1234567890abcdef
AUDIT_LOG_PATH=./data/audit.jsonl
USE_MOCK_NLI=true
VIRUSTOTAL_API_KEY=
